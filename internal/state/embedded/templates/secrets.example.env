# yashigatakae secrets — copy this file to ~/.yashigatakae/secrets.env on each machine
# and fill in real values. Never commit this file.

# Encryption key for kintsugi diffs sent to the VPS (32-byte random hex).
# Generate once: openssl rand -hex 32
KINTSUGI_KEY=

# Bifrost API key (the gateway requires this for non-localhost requests).
BIFROST_API_KEY=

# VPS host where mempalace + bifrost + hermes + kintsugi-relay run.
# Example: yashi.your-vps.example.com
VPS_HOST=

# SSH user on VPS (usually root or a dedicated yashi user).
VPS_SSH_USER=root

# Path to SSH private key authorized on VPS.
VPS_SSH_KEY=~/.ssh/id_ed25519

# GitHub Personal Access Token with repo:read for yashigatakae-state and
# yashigatakae-memory-mirror (private repos). Optional if using SSH auth.
GH_TOKEN=
